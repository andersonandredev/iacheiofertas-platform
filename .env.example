# Vars de nível de compose. `docker compose` lê ./.env automaticamente.
# Copie pra .env e ajuste. Segredo por serviço NÃO fica aqui — ver env/<svc>.env.example.

# Nome do projeto compose da stack de app (a infra usa -p iacheiofertas-infra na linha de comando).
COMPOSE_PROJECT_NAME=iacheiofertas

# --- tags de imagem (serviços seguem :main; fixe num SHA só pra rollout arriscado) ---
CORE_TAG=main
AGENT_GLP_TAG=main
AGENT_AQUARISMO_TAG=main
EVOLUTION_IMAGE_TAG=latest

# --- iacheiofertas-config (repo de dados: destinations / acl / targets) ---
# core e agentes clonam/atualizam este ref no boot e expõem o SHA em /v1/healthz -> config_rev
CONFIG_REPO_URL=https://github.com/andersonandredev/iacheiofertas-config
CONFIG_REF=main

# --- paths no host (bind mounts; facilita backup e a migração do cutover) ---
STATE_DIR=/opt/iacheiofertas/state

# --- core: dry-run transforma todo publish real (WhatsApp/Graph) em no-op que ainda loga ---
CORE_DRY_RUN=false

# --- sidecars busca_html_* — alcançados pelo túnel autossh reverso do Mac (172.17.0.1:1812x)
#     ou por nome de serviço, se rodarem como container na rede `iacheiofertas` ---
BUSCA_HTML_ML_API_URL=http://172.17.0.1:18123
BUSCA_HTML_ML_2_API_URL=
BUSCA_HTML_AMAZON_API_URL=http://172.17.0.1:18124
BUSCA_HTML_GOOGLE_SHOPPING_API_URL=http://172.17.0.1:18125

# --- Postgres do Evolution (docker-compose.infra.yml) ---
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=evolution_db
