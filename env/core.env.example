# env/core.env — segredo do serviço `core`. NÃO versionar (só este .example).
# Produção: decripte de env/core.env.sops (SOPS+age) OU mantenha só no VPS.

# --- LLM (único provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_BOT=claude-haiku-4-5

# --- URL pública (base dos links curtos /r/{codigo} e das imagens que a Graph API busca) ---
BASE_URL=
# Opcional por nicho: BASE_URL_<NICHE_UPPER> sobrescreve só as peças daquele nicho.
BASE_URL_ACHADOS_GLP=
BASE_URL_AQUARISMO_MARINHO=

# --- Evolution API (WhatsApp) ---
# EVOLUTION_API_URL é injetado pelo compose (http://evolution-api:8080).
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE_NAME=iacheiofertas

# --- Meta Graph API (feed/Story/Reels automáticos) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_SYSTEM_USER_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Credencial própria por nicho: <CONST>_<NICHE_UPPER> sobrescreve a global.
# FACEBOOK_SYSTEM_USER_TOKEN_ACHADOS_GLP=
# FACEBOOK_PAGE_ID_ACHADOS_GLP=
# FACEBOOK_PAGE_ACCESS_TOKEN_ACHADOS_GLP=
# INSTAGRAM_BUSINESS_ACCOUNT_ID_ACHADOS_GLP=

# --- HeyGen (Reels semanal com avatar) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID_ACHADOS_GLP=
HEYGEN_VOICE_ID_ACHADOS_GLP=
HEYGEN_AVATAR_ID_AQUARISMO_MARINHO=
HEYGEN_VOICE_ID_AQUARISMO_MARINHO=

# --- Afiliados ---
MERCADOLIVRE_MATT_WORD=
MERCADOLIVRE_MATT_TOOL=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Token de upload de sessão pros sidecars busca_html_* ---
UPLOAD_TOKEN=

# --- Trava de cooldown / teto diário (aplicada em POST /v1/publish, por destination_id) ---
COOLDOWN_MINUTOS=90
TETO_DIARIO_GRUPO=6

# --- Bot de comentário -> DM no Instagram ---
BOT_COMENTARIOS_TETO_HORA=20

# --- Portal de curadoria manual ---
CURADORIA_MANUAL_ATIVA=0
CURADORIA_USER=
CURADORIA_PASS=
CURADORIA_MAX_MB=100
