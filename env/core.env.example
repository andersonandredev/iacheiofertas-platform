# env/core.env — segredo do serviço `core`. NÃO versionar (só este .example).
# Produção: decripte de env/core.env.sops (SOPS+age) OU mantenha só no VPS.
#
# CONFIG_REPO_URL/CONFIG_REF/CONFIG_LOCAL_PATH, EVOLUTION_API_URL, DRY_RUN e
# BUSCA_HTML_*_API_URL são injetados pelo docker-compose.yml (vêm do .env de nível de
# compose, não daqui) — não precisa repetir aqui. Lista abaixo = exatamente o que
# app/config.py do core lê deste arquivo, nem mais nem menos.

# --- URL pública (base do link curto próprio /r/{codigo}, ver app/links.py) ---
# Precisa ser um domínio público de verdade, roteado no Caddy até localhost:8000 (ver
# docs/RUNBOOK.md) — com localhost o link não abre fora do próprio VPS.
BASE_URL=

# --- Mercado Livre ---
MERCADOLIVRE_MATT_WORD=
MERCADOLIVRE_MATT_TOOL=

# --- Amazon ---
AMAZON_PARTNER_TAG=

# --- Shopee ---
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE_NAME=iacheiofertas

# --- Meta Graph API (Instagram + Facebook) --- credencial global/fallback: usada quando
# destinations/<destination_id>.json no iacheiofertas-config não tem
# instagram_account_id/facebook_page_id próprio (ver app/destinations.py). O TOKEN é
# sempre este, não varia por destino ainda.
GRAPH_API_VERSION=v21.0
FACEBOOK_SYSTEM_USER_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- cooldown / teto diário default (acl/<niche_id>.json no config pode sobrescrever) ---
COOLDOWN_MINUTOS=90
TETO_DIARIO_DESTINO=6

# --- SQLite de cooldown/teto/idempotência — dentro do volume de estado montado (ver
# docker-compose.yml), senão zera a cada redeploy (mesmo gotcha do ingest_eventos.db no
# legado, já corrigido lá — não repetir aqui). ---
THROTTLE_DB_PATH=/app/state/throttle.db
LINKS_CURTOS_DB_PATH=/app/state/links_curtos.db
FEED_POSTS_DB_PATH=/app/state/feed_posts.db
ROTEIROS_DB_PATH=/app/state/roteiros.db

# --- Rotação de N dias no feed (instagram_feed/facebook_feed) — ver app/feed_rotacao.py.
# Só tem efeito pro nicho que tiver instagram_feed/facebook_feed nos targets dele (ver
# iacheiofertas-config). FEED_ROTACAO_JOB=0 desliga o worker inteiro (nenhum post é
# apagado, só fica acumulando registro — ok pra ambiente sem token com
# instagram_manage_contents). ---
FEED_ROTACAO_DIAS=7
FEED_ROTACAO_JOB=1
FEED_ROTACAO_INTERVALO_HORAS=6
