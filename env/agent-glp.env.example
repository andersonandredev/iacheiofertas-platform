# env/agent-glp.env — segredo do serviço `agent-glp` (nicho achados_glp).
# NÃO versionar. Produção: decripte de env/agent-glp.env.sops OU mantenha só no VPS.
# NICHE_ID e CORE_URL são injetados pelo compose.

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- dedup (SQLite local no volume /app/state) ---
CACHE_DB_PATH=/app/state/cache.db
CACHE_TTL_HORAS=72
# Queda mínima (pp) pra permitir reenviar um item já postado dentro da retenção.
QUEDA_MINIMA_PCT=5

# --- garimpo ---
MINERACAO_INTERVALO_MINUTOS=30
TIMEZONE=America/Sao_Paulo
GARIMPO_INICIO=07:30
GARIMPO_FIM=20:30

# --- espelha o dry-run do core: agente monta o publish mas manda dry_run=true ---
DRY_RUN=false
