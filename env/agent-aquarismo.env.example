# env/agent-aquarismo.env — segredo do serviço `agent-aquarismo` (nicho aquarismo_marinho).
# NÃO versionar. Produção: decripte de env/agent-aquarismo.env.sops OU mantenha só no VPS.
# NICHE_ID e CORE_URL são injetados pelo compose.

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- dedup (SQLite local no volume /app/state) ---
CACHE_DB_PATH=/app/state/cache.db
CACHE_TTL_HORAS=72
QUEDA_MINIMA_PCT=5

# --- garimpo (aquarismo hoje é "só do catálogo", 5 chunks — ver memória) ---
MINERACAO_INTERVALO_MINUTOS=30
TIMEZONE=America/Sao_Paulo
GARIMPO_INICIO=07:30
GARIMPO_FIM=20:30

DRY_RUN=false
